# dype project environment — fix sort/comm collation without breaking UTF-8 I/O
export LC_COLLATE=C

# Python venv
source .venv/bin/activate 2>/dev/null

# === dype dev environment ===
# 注册 dype-core 到 GHC 包数据库 (interaction 测试 runghc 需要)
# 兼容 cabal (dist-newstyle) 和 stack (.stack-work)
layout_dype() {
  local pkgdb
  if [ -d dist-newstyle ]; then
    pkgdb=$(find dist-newstyle -path "*/dype-core-*/package.conf.inplace" -type d 2>/dev/null | head -1)
  if [ -n "$pkgdb" ]; then
    local envfile=".ghc.environment.$(uname -m)-linux-$(ghc --numeric-version 2>/dev/null || echo 9.14.1)"
    echo "global-package-db" > "$envfile"
    echo "package-db $pkgdb" >> "$envfile"
  fi
}
layout_dype
